# ─────────────────────────────────────────────────────────────
# Eagles Flight — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any real key to Git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix with NEXT_PUBLIC_. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database (Project Settings → Database → Connection string URI)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── First admin (used by db:setup only; change password on first login)
FIRST_ADMIN_EMAIL=admin@eaglesflight.local
FIRST_ADMIN_PASSWORD=ChangeMe!2025